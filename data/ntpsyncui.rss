/*
 * ntpsyncui.rss - the NTP Time Sync app's resources: the menu, the softkeys, the queries
 * and every text on the screen.
 *
 * Built twice: as ntpsyncui.rsc with the Vietnamese texts of ntpsyncui_vi.loc (the
 * default), and from ntpsyncui_en.rss, which defines NTPSYNCUI_LANG_EN and includes this
 * file, as ntpsyncui_en.rsc with those of ntpsyncui_en.loc. Same NAME and same resources
 * in the same order, so the same IDs; the app swaps one file for the other at run time.
 */
NAME NTPU
CHARACTER_SET UTF8

#include <eikon.rh>
#include <avkon.rh>
#include <avkon.rsg>
#include <appinfo.rh>
#include "ntpsyncui.hrh"

#ifdef NTPSYNCUI_LANG_EN
#include "ntpsyncui_en.loc"
#else
#include "ntpsyncui_vi.loc"
#endif

// The first three stay first: the framework reads EIK_APP_INFO as the third resource.
RESOURCE RSS_SIGNATURE { }

RESOURCE TBUF r_default_document_name { buf = ""; }

RESOURCE EIK_APP_INFO
	{
	menubar = r_ntp_menubar;
	cba = r_ntp_softkeys_options_exit;
	}

// Own softkeys, in the language of the texts (Avkon's would be in the phone's).
// The command ids are Avkon's, so they act as Avkon's softkeys do.
RESOURCE CBA r_ntp_softkeys_options_exit
	{
	buttons =
		{
		CBA_BUTTON { id = EAknSoftkeyOptions; txt = qtn_ntp_sk_options; },
		CBA_BUTTON { id = EAknSoftkeyExit;    txt = qtn_ntp_sk_exit; }
		};
	}

RESOURCE CBA r_ntp_softkeys_options_back
	{
	buttons =
		{
		CBA_BUTTON { id = EAknSoftkeyOptions; txt = qtn_ntp_sk_options; },
		CBA_BUTTON { id = EAknSoftkeyBack;    txt = qtn_ntp_sk_back; }
		};
	}

RESOURCE CBA r_ntp_softkeys_ok_cancel
	{
	buttons =
		{
		CBA_BUTTON { id = EAknSoftkeyOk;     txt = qtn_ntp_sk_ok; },
		CBA_BUTTON { id = EAknSoftkeyCancel; txt = qtn_ntp_sk_cancel; }
		};
	}

RESOURCE CBA r_ntp_softkeys_yes_no
	{
	buttons =
		{
		CBA_BUTTON { id = EAknSoftkeyYes; txt = qtn_ntp_sk_yes; },
		CBA_BUTTON { id = EAknSoftkeyNo;  txt = qtn_ntp_sk_no; }
		};
	}

RESOURCE CBA r_ntp_softkeys_close
	{
	buttons =
		{
		CBA_BUTTON { id = EAknSoftkeyEmpty; txt = ""; },
		CBA_BUTTON { id = EAknSoftkeyClose; txt = qtn_ntp_sk_close; }
		};
	}

RESOURCE MENU_BAR r_ntp_menubar
	{
	titles = { MENU_TITLE { menu_pane = r_ntp_menu; } };
	}

// One menu for both screens: CNtpUiAppUi::DynInitMenuPaneL hides the items that do not
// apply to the one in front.
RESOURCE MENU_PANE r_ntp_menu
	{
	items =
		{
		MENU_ITEM { command = ENtpUiCmdChange;   txt = qtn_ntp_menu_change; },
		MENU_ITEM { command = ENtpUiCmdSyncNow;  txt = qtn_ntp_menu_sync_now; },
		MENU_ITEM { command = ENtpUiCmdSettings; txt = qtn_ntp_menu_settings; },
		MENU_ITEM { command = ENtpUiCmdLog;      txt = qtn_ntp_menu_log; },
		MENU_ITEM { command = ENtpUiCmdStop;    txt = qtn_ntp_menu_stop; },
		MENU_ITEM { command = ENtpUiCmdStart;   txt = qtn_ntp_menu_start; },
		MENU_ITEM { command = EAknSoftkeyExit;  txt = qtn_ntp_menu_exit; }
		};
	}

// Stop background sync: Yes / No.
RESOURCE DIALOG r_ntp_stop_query
	{
	flags = EGeneralQueryFlags;
	buttons = r_ntp_softkeys_yes_no;
	items =
		{
		DLG_LINE
			{
			type = EAknCtQuery;
			id = EGeneralQuery;
			control = AVKON_CONFIRMATION_QUERY
				{
				layout = EConfirmationQueryLayout;
				label = qtn_ntp_query_stop;
				};
			}
		};
	}

// The log: a heading (set in the code from r_ntp_str_log_title) and the text.
RESOURCE DIALOG r_ntp_log_query
	{
	flags = EGeneralQueryFlags | EEikDialogFlagNoBorder | EEikDialogFlagNoShadow;
	buttons = r_ntp_softkeys_close;
	items =
		{
		DLG_LINE
			{
			type = EAknCtPopupHeadingPane;
			id = EAknMessageQueryHeaderId;
			control = AVKON_HEADING
				{
				label = "";
				headinglayout = R_AVKON_LIST_HEADING_PANE;
				};
			},
		DLG_LINE
			{
			type = EAknCtMessageQuery;
			id = EAknMessageQueryContentId;
			control = AVKON_MESSAGE_QUERY
				{
				};
			}
		};
	}

// The texts of the status screen and the notes; %d and %S are filled in by the code.
RESOURCE TBUF r_ntp_str_row_state         { buf = qtn_ntp_row_state; }
RESOURCE TBUF r_ntp_str_row_last          { buf = qtn_ntp_row_last; }
RESOURCE TBUF r_ntp_str_row_attempt       { buf = qtn_ntp_row_attempt; }
RESOURCE TBUF r_ntp_str_row_server        { buf = qtn_ntp_row_server; }
RESOURCE TBUF r_ntp_str_row_wifi          { buf = qtn_ntp_row_wifi; }
RESOURCE TBUF r_ntp_str_row_next          { buf = qtn_ntp_row_next; }
RESOURCE TBUF r_ntp_str_val_running       { buf = qtn_ntp_val_running; }
RESOURCE TBUF r_ntp_str_val_syncing       { buf = qtn_ntp_val_syncing; }
RESOURCE TBUF r_ntp_str_val_stopped       { buf = qtn_ntp_val_stopped; }
RESOURCE TBUF r_ntp_str_val_none          { buf = qtn_ntp_val_none; }
RESOURCE TBUF r_ntp_str_val_corrected     { buf = qtn_ntp_val_corrected; }
RESOURCE TBUF r_ntp_str_val_right         { buf = qtn_ntp_val_right; }
RESOURCE TBUF r_ntp_str_val_set_failed    { buf = qtn_ntp_val_set_failed; }
RESOURCE TBUF r_ntp_str_val_failed        { buf = qtn_ntp_val_failed; }
RESOURCE TBUF r_ntp_str_val_no_wifi       { buf = qtn_ntp_val_no_wifi; }
RESOURCE TBUF r_ntp_str_val_cancelled     { buf = qtn_ntp_val_cancelled; }
RESOURCE TBUF r_ntp_str_val_iap_id        { buf = qtn_ntp_val_iap_id; }
RESOURCE TBUF r_ntp_str_val_unknown       { buf = qtn_ntp_val_unknown; }
RESOURCE TBUF r_ntp_str_val_not_scheduled { buf = qtn_ntp_val_not_scheduled; }
RESOURCE TBUF r_ntp_str_note_started      { buf = qtn_ntp_note_started; }
RESOURCE TBUF r_ntp_str_note_command_failed { buf = qtn_ntp_note_command_failed; }
RESOURCE TBUF r_ntp_str_note_save_failed  { buf = qtn_ntp_note_save_failed; }
RESOURCE TBUF r_ntp_str_note_start_failed { buf = qtn_ntp_note_start_failed; }
