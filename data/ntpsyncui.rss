RESOURCE TBUF r_ntp_str_note_no_iaps      { buf = qtn_ntp_note_no_iaps; }
RESOURCE TBUF r_ntp_str_settings_title    { buf = qtn_ntp_settings_title; }
RESOURCE TBUF r_ntp_str_set_iaps_none     { buf = qtn_ntp_set_iaps_none; }

// The app's name for the title pane: the same in both languages.
RESOURCE TBUF r_ntp_str_title             { buf = "NTP Time Sync"; }

// ---------------------------------------------------------------------------
// The settings screen (CNtpSettingList), the rows in the order of TNtpSettingId.

RESOURCE AVKON_SETTING_ITEM_LIST r_ntp_setting_list
	{
	title = qtn_ntp_settings_title;
	items =
		{
		// edited on a page the code opens (the Wi-Fi access points); the page here is not used
		AVKON_SETTING_ITEM
			{
			identifier = ENtpSetIaps;
			name = qtn_ntp_set_iaps;
			setting_page_resource = r_ntp_text_page;
			},
		AVKON_SETTING_ITEM
			{
			identifier = ENtpSetInterval;
			name = qtn_ntp_set_interval;
			setting_page_resource = r_ntp_popup_page;
			associated_resource = r_ntp_interval_texts;
			},
		AVKON_SETTING_ITEM
			{
			identifier = ENtpSetThreshold;
			name = qtn_ntp_set_threshold;
			setting_page_resource = r_ntp_popup_page;
			associated_resource = r_ntp_threshold_texts;
			},
		AVKON_SETTING_ITEM
			{
			identifier = ENtpSetWatch;
			name = qtn_ntp_set_watch;
			setting_page_resource = r_ntp_popup_page;
			associated_resource = r_ntp_onoff_texts;
			},
		AVKON_SETTING_ITEM
			{
			identifier = ENtpSetServers;
			name = qtn_ntp_set_servers;
			setting_page_resource = r_ntp_servers_page;
			},
		AVKON_SETTING_ITEM
			{
			identifier = ENtpSetLanguage;
			name = qtn_ntp_set_language;
			setting_page_resource = r_ntp_popup_page;
			associated_resource = r_ntp_language_texts;
			}
		};
	}

// The page of a row with a few values (the row's name is its title).
RESOURCE AVKON_SETTING_PAGE r_ntp_popup_page
	{
	label = "";
	softkey_resource = r_ntp_softkeys_ok_cancel;
	type = EAknCtPopupSettingList;
	editor_resource_id = r_ntp_popup_list;
	}

RESOURCE POPUP_SETTING_LIST r_ntp_popup_list
	{
	flags = 0;
	}

// A one line text page (only the access points row names it, and it is not opened).
RESOURCE AVKON_SETTING_PAGE r_ntp_text_page
	{
	label = "";
	softkey_resource = r_ntp_softkeys_ok_cancel;
	type = EEikCtEdwin;
	editor_resource_id = r_ntp_text_edwin;
	}

RESOURCE EDWIN r_ntp_text_edwin
	{
	flags = EEikEdwinNoLineOrParaBreaks;
	width = 16;
	lines = 1;
	maxlength = 255;
	default_case = EAknEditorLowerCase;
	avkon_flags = EAknEditorFlagNoT9 | EAknEditorFlagLatinInputModesOnly;
	}

// The servers' page: one host name per line, no predictive text. It can be left empty
// (the daemon then uses its own servers).
RESOURCE AVKON_SETTING_PAGE r_ntp_servers_page
	{
	label = "";
	softkey_resource = r_ntp_softkeys_ok_cancel;
	type = EEikCtEdwin;
	editor_resource_id = r_ntp_servers_edwin;
	}

RESOURCE EDWIN r_ntp_servers_edwin
	{
	flags = 0;
	width = 16;
	lines = 5;
	maxlength = 255;
	default_case = EAknEditorLowerCase;
	avkon_flags = EAknEditorFlagNoT9 | EAknEditorFlagLatinInputModesOnly;
	}

// The page of the Wi-Fi access points: a list with a check box on each (the items are
// made in the code).
RESOURCE AVKON_SETTING_PAGE r_ntp_iaps_page
	{
	label = qtn_ntp_set_iaps;
	softkey_resource = r_ntp_softkeys_ok_cancel;
	type = EAknSetListBox;
	editor_resource_id = r_ntp_iaps_listbox;
	}

RESOURCE LISTBOX r_ntp_iaps_listbox
	{
	flags = EAknListBoxMultiselectionList;
	}

// Sync interval: the value is the index (0..7), the minutes are in ntpsettinglist.cpp.
RESOURCE AVKON_POPUP_SETTING_TEXTS r_ntp_interval_texts
	{
	setting_texts_resource = r_ntp_interval_values;
	popped_up_texts_resource = r_ntp_interval_popped;
	}

RESOURCE ARRAY r_ntp_interval_values
	{
	items =
		{
		AVKON_ENUMERATED_TEXT { value = 0; text = qtn_ntp_interval_15m; },
		AVKON_ENUMERATED_TEXT { value = 1; text = qtn_ntp_interval_30m; },
		AVKON_ENUMERATED_TEXT { value = 2; text = qtn_ntp_interval_1h; },
		AVKON_ENUMERATED_TEXT { value = 3; text = qtn_ntp_interval_3h; },
		AVKON_ENUMERATED_TEXT { value = 4; text = qtn_ntp_interval_6h; },
		AVKON_ENUMERATED_TEXT { value = 5; text = qtn_ntp_interval_12h; },
		AVKON_ENUMERATED_TEXT { value = 6; text = qtn_ntp_interval_24h; },
		AVKON_ENUMERATED_TEXT { value = 7; text = qtn_ntp_interval_1w; }
		};
	}

RESOURCE ARRAY r_ntp_interval_popped
	{
	items =
		{
		LBUF { txt = qtn_ntp_interval_15m; },
		LBUF { txt = qtn_ntp_interval_30m; },
		LBUF { txt = qtn_ntp_interval_1h; },
		LBUF { txt = qtn_ntp_interval_3h; },
		LBUF { txt = qtn_ntp_interval_6h; },
		LBUF { txt = qtn_ntp_interval_12h; },
		LBUF { txt = qtn_ntp_interval_24h; },
		LBUF { txt = qtn_ntp_interval_1w; }
		};
	}

// Correction threshold: the value is the index (0..4).
RESOURCE AVKON_POPUP_SETTING_TEXTS r_ntp_threshold_texts
	{
	setting_texts_resource = r_ntp_threshold_values;
	popped_up_texts_resource = r_ntp_threshold_popped;
	}

RESOURCE ARRAY r_ntp_threshold_values
	{
	items =
		{
		AVKON_ENUMERATED_TEXT { value = 0; text = qtn_ntp_threshold_100; },
		AVKON_ENUMERATED_TEXT { value = 1; text = qtn_ntp_threshold_500; },
		AVKON_ENUMERATED_TEXT { value = 2; text = qtn_ntp_threshold_1000; },
		AVKON_ENUMERATED_TEXT { value = 3; text = qtn_ntp_threshold_2000; },
		AVKON_ENUMERATED_TEXT { value = 4; text = qtn_ntp_threshold_5000; }
		};
	}

RESOURCE ARRAY r_ntp_threshold_popped
	{
	items =
		{
		LBUF { txt = qtn_ntp_threshold_100; },
		LBUF { txt = qtn_ntp_threshold_500; },
		LBUF { txt = qtn_ntp_threshold_1000; },
		LBUF { txt = qtn_ntp_threshold_2000; },
		LBUF { txt = qtn_ntp_threshold_5000; }
		};
	}

// On / Off (CAknBinaryPopupSettingItem: the values 1 and 0).
RESOURCE AVKON_POPUP_SETTING_TEXTS r_ntp_onoff_texts
	{
	setting_texts_resource = r_ntp_onoff_values;
	popped_up_texts_resource = r_ntp_onoff_popped;
	}

RESOURCE ARRAY r_ntp_onoff_values
	{
	items =
		{
		AVKON_ENUMERATED_TEXT { value = 1; text = qtn_ntp_set_on; },
		AVKON_ENUMERATED_TEXT { value = 0; text = qtn_ntp_set_off; }
		};
	}

RESOURCE ARRAY r_ntp_onoff_popped
	{
	items =
		{
		LBUF { txt = qtn_ntp_set_on; },
		LBUF { txt = qtn_ntp_set_off; }
		};
	}

// The language of the app's screens (TNtpUiLanguage).
RESOURCE AVKON_POPUP_SETTING_TEXTS r_ntp_language_texts
	{
	setting_texts_resource = r_ntp_language_values;
	popped_up_texts_resource = r_ntp_language_popped;
	}

RESOURCE ARRAY r_ntp_language_values
	{
	items =
		{
		AVKON_ENUMERATED_TEXT { value = 0; text = qtn_ntp_lang_vi; },
		AVKON_ENUMERATED_TEXT { value = 1; text = qtn_ntp_lang_en; }
		};
	}

RESOURCE ARRAY r_ntp_language_popped
	{
	items =
		{
		LBUF { txt = qtn_ntp_lang_vi; },
		LBUF { txt = qtn_ntp_lang_en; }
		};
	}

// The caption and the icon in the phone's menu: gfx/ntpsyncui.svg, made into
